[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = {extras = ["standard"], version = "*"}
tensorflow-cpu="*"
numpy = "*"
scikit-image = "*"

[dev-packages]
tensorflow-datasets = "*"
matplotlib = "*"
opencv-python = "*"
imutils= "*"
httpx="*"
pygame-ce = "2.4.1"
httpx-retries="*"

[requires]
python_version = "3.11"

[scripts]
create="python -m create_model"
use="python -m use_model"
game-local="python -m pygame_ui"
noise="python -m noise"
api-dev="bash -c './build_web_dev.sh'"
api-prod="bash -c './build_web_prod.sh'"