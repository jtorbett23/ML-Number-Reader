[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
tensorflow = "*"
numpy = "*"
scikit-image = "*"
pygame-ce = "*"
fastapi = {extras = ["standard"], version = "*"}

[dev-packages]
tensorflow-datasets = "*"
matplotlib = "*"
opencv-python = "*"
imutils= "*"

[requires]
python_version = "3.11"

[scripts]
create="python -m create_model"
use="python -m use_model"
game="python -m game"
noise="python -m noise"
pygbag="python -m pygbag ."
api-dev="python -m fastapi dev api.py"
api-prod="python -m fastapi run api.py"
