[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = {extras = ["standard"], version = "*"}
tensorflow-cpu="*"
numpy = "*"
scikit-image = "*"

[dev-packages]
tensorflow-datasets = "*"
matplotlib = "*"
opencv-python = "*"
imutils= "*"
httpx="*"
pygame-ce = "2.4.1"
httpx-retries="*"

[requires]
python_version = "3.11"

[scripts]
create="python -m create_model"
use="python -m use_model"
game="python -m game"
noise="python -m noise"
api-dev="python -m fastapi dev api.py --port 8080"
api-prod="python -m fastapi run api.py --port 8080"