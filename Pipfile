[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = {extras = ["standard"], version = "*"}
starlette = ">=0.49.1"
tensorflow-cpu = "*"
numpy = "*"
scikit-image = "*"
python-dotenv = "*"
keras = ">=3.13.1"
urllib3 = ">=2.6.3"
python-multipart = ">=0.0.22"
wheel = ">=0.46.2"
fonttools = ">=4.60.2"
Werkzeug = ">=3.1.5"

[dev-packages]
tensorflow-datasets = "*"
matplotlib = "*"
opencv-python = "*"
imutils= "*"
httpx="*"
pygame-ce = "2.4.1"
httpx-retries="*"

[requires]
python_version = "3.11"

[scripts]
create="python -m create_model"
game-local="python -m pygame_ui_local"
gh-pages="bash -c './scripts/gh-pages.sh'"
api="bash -c './scripts/web_dev.sh'"
api-prod="python -m fastapi run digit_reader.py --port 8080"
api-split="bash -c './scripts/web_dev_split.sh'"
api-reader="python -m fastapi dev digit_reader.py --port 8080"
api-ui="bash -c './scripts/web_dev_ui_only.sh'"
